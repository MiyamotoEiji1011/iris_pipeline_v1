[Unit]
Description=Iris Pipeline main controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/iris_pipeline_v1/raspi
# .venv/bin/python を直接指定することで仮想環境を使用する（source activate 相当）
Environment="VIRTUAL_ENV=/home/pi/iris_pipeline_v1/raspi/.venv"
Environment="PATH=/home/pi/iris_pipeline_v1/raspi/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/pi/iris_pipeline_v1/raspi/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
